# Supabase > Project Settings > API (use the anon / publishable key, NEVER the service_role key)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
VITE_MAILERLITE_FORM_ID=YOUR_EMBEDDED_FORM_ID

# Where the site is hosted. Hostinger (domain root): VITE_BASE_PATH=/
# VITE_SITE_URL is used for social-media link previews; it must end with "/".
VITE_BASE_PATH=/
VITE_SITE_URL=https://www.agroaerialprecision.com/
