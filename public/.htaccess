# Agro Aerial Precision - Hostinger (Apache) settings

# Clean addresses (/about, /services/mining, ...): serve index.html for any
# address that isn't a real file or folder, and let the app show the page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always use https://www.agroaerialprecision.com
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^agroaerialprecision\.com$ [NC]
  RewriteRule ^ https://www.agroaerialprecision.com%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

DirectoryIndex index.html

# Never serve the deploy tool's sync file
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Cache built assets (their names change on every build); always re-check index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpe?g|png|webp|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
